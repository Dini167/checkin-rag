# העתיקו את הקובץ ל־.env ומלאו את המפתחות.
# מפתח Gemini: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# מפתח Groq (גיבוי ושופט בהערכה): https://console.groq.com/keys
GROQ_API_KEY=

# --- הגדרות אופציונליות (אלה ערכי ברירת המחדל) ---
# ANSWER_MODEL_NAME=gemini-3.5-flash-lite
# BACKUP_ANSWER_MODEL_NAMES=gemini-3.1-flash-lite,gemini-3.6-flash
# QUESTION_ANALYSIS_MODEL_NAME=gemini-3.5-flash-lite
# FALLBACK_MODEL_NAME=openai/gpt-oss-120b
# EMBEDDING_PROVIDER=gemini
# GEMINI_EMBEDDING_MODEL_NAME=gemini-embedding-001
# CHUNK_SIZE_TOKENS=500
# CHUNK_OVERLAP_TOKENS=75
# TOP_K=5
# RELEVANCE_THRESHOLD=0.6
# BM25_STRIP_HEBREW_PREFIXES=false
# QUERY_REWRITING_ENABLED=true
